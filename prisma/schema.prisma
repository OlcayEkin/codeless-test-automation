generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  ADMIN
  MEMBER
}

model Team {
  id        String     @id @default(cuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  users     User[]
  testPlans TestPlan[]
}

model User {
  id           String     @id @default(cuid())
  email        String?    @unique
  username     String?    @unique
  name         String
  passwordHash String
  role         Role       @default(MEMBER)
  teamId       String
  team         Team       @relation(fields: [teamId], references: [id])
  createdAt    DateTime   @default(now())
  testPlans    TestPlan[]
  uploads      TestPlanVersion[]
  testRuns      TestRun[]
  triaged       TestRunResult[]
  schedules     TestSchedule[]
  notifications Notification[]
}

model TestPlan {
  id          String            @id @default(cuid())
  name        String
  teamId      String
  team        Team              @relation(fields: [teamId], references: [id])
  createdById String
  createdBy   User              @relation(fields: [createdById], references: [id])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  versions    TestPlanVersion[]
  runs        TestRun[]
  schedules   TestSchedule[]
  config      PlanConfig?
  /// Set when this plan was created from the failures of an earlier run.
  sourceRunId String?
  sourceRun   TestRun?          @relation("FollowUpPlans", fields: [sourceRunId], references: [id], onDelete: SetNull)

  @@index([teamId])
}

/// Every upload creates a new version. Old versions are kept so past results still point to the tests that ran.
model TestPlanVersion {
  id            String     @id @default(cuid())
  planId        String
  plan          TestPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  version       Int
  fileName      String
  format        String // xlsx, csv or json
  uploadedById  String
  uploadedBy    User       @relation(fields: [uploadedById], references: [id])
  createdAt     DateTime   @default(now())
  /// scored, unavailable or skipped: whether Jev quality scores were collected for this upload.
  qualityStatus String
  testCases     TestCase[]
  runs          TestRun[]

  @@unique([planId, version])
}

model TestCase {
  id         String          @id @default(cuid())
  versionId  String
  version    TestPlanVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  position   Int
  externalId String
  name       String
  /// Jev scores and plain-language flags, or null when scoring was not available.
  quality    Json?
  steps      TestStep[]

  @@unique([versionId, externalId])
}

model TestStep {
  id         String   @id @default(cuid())
  testCaseId String
  testCase   TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  position    Int
  /// What this step is for, in the tester's own words. Not used when running.
  description String?
  action     String
  target     String?
  value      String?
  expected   String?
}

/// One press of Play. The worker process picks up queued runs, oldest first.
model TestRun {
  id            String          @id @default(cuid())
  planId        String
  plan          TestPlan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  versionId     String
  version       TestPlanVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   User            @relation(fields: [requestedById], references: [id])
  /// Comma separated: web, api.
  testTypes     String
  browser       String
  headless      Boolean
  /// queued, running, cancelling, completed, cancelled or error.
  status        String          @default("queued")
  error         String?
  total         Int             @default(0)
  passed        Int             @default(0)
  failed        Int             @default(0)
  blocked       Int             @default(0)
  createdAt     DateTime        @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?
  results       TestRunResult[]
  followUpPlans TestPlan[]      @relation("FollowUpPlans")
  /// Set when the run was started by a schedule instead of the Run tests button.
  scheduleId    String?
  schedule      TestSchedule?   @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  /// app, schedule or ci: what started the run.
  source        String          @default("app")
  /// For CI runs: the pipeline run's id and link.
  ciInfo        Json?
  notifications Notification[]

  @@index([status, createdAt])
  @@index([planId, createdAt])
}

model TestRunResult {
  id         String   @id @default(cuid())
  runId      String
  run        TestRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  position   Int
  testCaseId String
  name       String
  browser    String
  /// passed, failed or blocked.
  status     String
  durationMs Int
  error      String?
  failedStep Int?
  /// Paths inside the run's results folder, only for tests that did not pass.
  screenshot String?
  trace      String?
  video      String?
  steps      Json
  createdAt  DateTime @default(now())
  /// Our first review's guess: probability that this failure is a real bug in the application.
  bugLikelihood Float?
  /// The team's decision: bug or test_issue (a problem with the test or its environment).
  triage        String?
  triagedById   String?
  triagedBy     User?     @relation(fields: [triagedById], references: [id])
  triagedAt     DateTime?
}

/// Starts runs automatically. Each run uses the plan's latest version at the time it starts.
model TestSchedule {
  id          String    @id @default(cuid())
  planId      String
  plan        TestPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  testTypes   String
  browser     String
  headless    Boolean
  startAt     DateTime
  /// once, daily, weekdays or weekly.
  repeat      String
  /// When the worker should start the next run; null once a one-time schedule has run.
  nextRunAt   DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  runs        TestRun[]

  @@index([active, nextRunAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  runId     String?
  run       TestRun?  @relation(fields: [runId], references: [id], onDelete: Cascade)
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

/// Where a plan's tests run. "local" needs nothing else; "ci" sends runs to GitHub Actions.
model PlanConfig {
  id                   String    @id @default(cuid())
  planId               String    @unique
  plan                 TestPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  /// local or ci
  mode                 String    @default("local")
  /// github (the only CI provider for now)
  provider             String    @default("github")
  /// owner/name
  repository           String?
  workflowFile         String?
  branch               String?
  /// Base address of the environment the tests run against, for paths such as /login.
  baseUrl              String?
  /// AES-256-GCM encrypted access token; never sent back to the browser.
  tokenEncrypted       String?
  /// Last four characters, shown so people can tell which token is saved.
  tokenHint            String?
  /// access or failed, from the last connection check.
  connectionStatus     String?
  connectionMessage    String?
  connectionCheckedAt  DateTime?
  updatedById          String?
  updatedAt            DateTime  @updatedAt
}
